rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasExactDemoRequestShape() {
      return request.resource.data.keys().hasAll([
          'nombre',
          'apellido',
          'email',
          'empresa',
          'cargo',
          'interes',
          'mensaje',
          'consentimiento',
          'createdAt',
          'source',
          'status'
        ])
        && request.resource.data.keys().hasOnly([
          'nombre',
          'apellido',
          'email',
          'empresa',
          'cargo',
          'interes',
          'mensaje',
          'consentimiento',
          'createdAt',
          'source',
          'status'
        ]);
    }

    function validText(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }

    function validInterest(value) {
      return value in [
        'Inteligencia Artificial',
        'Automatización',
        'Software Empresarial',
        'Cloud',
        'LCH Evidence AI',
        'Otro'
      ];
    }

    match /demoRequests/{docId} {
      allow create: if hasExactDemoRequestShape()
        && validText(request.resource.data.nombre, 1, 80)
        && validText(request.resource.data.apellido, 1, 80)
        && validText(request.resource.data.email, 3, 254)
        && validText(request.resource.data.empresa, 1, 160)
        && validText(request.resource.data.cargo, 1, 160)
        && validInterest(request.resource.data.interes)
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() <= 2000
        && request.resource.data.consentimiento == true
        && request.resource.data.source == 'website'
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
